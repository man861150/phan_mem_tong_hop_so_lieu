DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://solieu:solieu@127.0.0.1:5432/solieu

# M1-T05's verification text mentions five failed logins. The running default
# remains 10 until the product owner decides; set this variable to override it.
AXES_FAILURE_LIMIT=10

# LAN development only. Comma-separated, and every entry needs a scheme.
# Add the Mac's current LAN IP and, if used, its .local hostname:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.20,My-Mac.local
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.20:8000,http://My-Mac.local:8000
